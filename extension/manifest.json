{
  "manifest_version": 3,
  "name": "浏览器助手",
  "description": "通过 Rust Native Messaging 提供受控的网页 DOM 读取与自动化能力。",
  "version": "0.2.0",
  "minimum_chrome_version": "105",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "nativeMessaging",
    "debugger"
  ],
  "action": {
    "default_title": "浏览器助手",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon128.png",
      "32": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon128.png",
    "32": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  }
}
